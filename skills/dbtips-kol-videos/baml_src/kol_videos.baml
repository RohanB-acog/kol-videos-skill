// GENERATED by aganitha-ie-skill-creator. Never hand-edit.
// Conforms to the dbtips /market-intelligence/kol-videos/ record contract as
// produced by rag_pipeline/dbutils.py::fetch_kol_interviews_metadata_and_analysis
// The consumer contract is the field set and the string typing, not any one UI.
//
// Every field is `string?`. That is the project's contract, not a weakening of
// it: dbutils.py coerces every value with `str(value) if value is not None else
// None`, so a number never reaches a consumer as a number.

class KolVideoRecord {
  search_name string? @description("The disease this record was gathered for, lowercased, spaces preserved. Echoed unchanged from the request; never inferred from the video.")
  video_id string? @description("The bare YouTube id, never a URL. Consumers build thumbnail and embed URLs from it.")
  title string? @description("Video title exactly as published. Never paraphrased or truncated.")
  firstname string? @description("KOL given name, or null. Required downstream: publication-kol.ts builds the publications URL from firstname plus the FIRST WORD of lastname, and drops the record when either is missing. If only one name is given, put it here and set lastname null.")
  lastname string? @description("KOL family name, or null. Only its first word is used when building the publications URL.")
  kol_name string? @description("'Dr. Firstname Lastname' only if 'Dr.' is explicitly present, otherwise 'Firstname Lastname'. Strip Mr./Ms./Professor and any role suffix. CRITICAL: this string is the person's identity key, so one person must appear under exactly one spelling across every record. Prefer an identity-resolved spelling from the candidate stage over a name heard in auto-captions, which mistranscribe names constantly.")
  affiliation string? @description("'Institution, Country' where stated. Prefer the affiliation carried by the candidate stage (PubMed author string or trial registry record) over one spoken in the transcript. Null rather than guessed.")
  expertise string? @description("Clinical or research field tied to this disease, e.g. 'Sleep medicine', 'Otolaryngology'. Strip it out of the name if it arrived attached to one. Null when unclear.")
  current_practice string? @description("DESCRIPTIVE, no judgement. What treatments or management approaches this speaker says are being used NOW: standard of care, sequencing, patient selection, diagnostic pathway. A factual recap of practice as the speaker reports it. Null if the video describes no current practice.")
  stance string? @description("THE ACTUAL OPINION. An explicit position, disagreement, criticism, or call to change practice — 'X is overused', 'the guidelines are behind the evidence', 'Y should be first-line', 'that trial was underpowered'. Must be a position the speaker takes, not a fact they report. NULL if the video is purely descriptive — most teaching content is, and a null here is the correct answer rather than a failure.")
  unmet_needs string? @description("DESCRIPTIVE, not opinion. Pain points and gaps the speaker explicitly names: side effects, access and cost barriers, diagnostic delay, non-adherence, lack of durable response, populations who are missed. Only what is stated, never inferred from the topic. Null if none are named.")
  video_url string? @alias("video") @description("https://www.youtube.com/watch?v=<video_id>. NOTE: the consumer's field name is `video`, which is a reserved BAML keyword, so the field is declared as video_url and aliased back. Serialise it as `video`.")
  publications string? @description("A PubMed URL for this person's work. Null when first or last name is missing, because a name-guess search URL that resolves to the wrong author is worse than an absent link.")
  published_date string? @description("Upload date as YYYY-MM-DD. Not YYYYMMDD: consumers parse this as a date.")
  view_count string? @description("View count at extraction time, digits only as a string.")
  channel_name string? @description("Publishing channel. Who posted it is an authority signal: a society, university or conference channel invited the talk; a re-upload did not.")
  duration_seconds string? @description("Duration in whole seconds, digits only as a string.")
}

class KolVideoAssessment {
  video_id string
  video_type string @description("Exactly one of: 'KOL interview' | 'patient story' | 'informational'. Only 'KOL interview' records reach the endpoint. A video that never discusses the disease yields no records at all.")
  discusses_disease bool @description("True only if the transcript or metadata actually discusses the disease or a recognised synonym. False here means emit no records for this video.")
  speaker_confirmed bool @description("True only if the transcript shows this person speaking or being introduced. A name in the title is not confirmation — [[a-search-url-is-not-a-citation]].")
  transcript_available bool @description("False when no captions could be fetched. Distinct from a video with captions and no KOL: one is a tool outcome, the other a finding — [[tool-failure-is-not-a-finding]].")
  notes string?
}

class Assumption {
  decision string
  chose string
  basis string
  would_have_asked string @description("What a person would have been asked, had one been available — [[mark-what-a-human-would-have-confirmed]]")
}

class Conflict {
  subject string @description("What the readings disagree about, e.g. an affiliation stated in transcript vs registry")
  readings string[] @description("Every reading, each with its own provenance — [[report-disagreement]]")
  extraction_rechecked bool @description("Whether the extraction was re-verified before treating this as a real difference — [[suspect-extraction-first]]")
}

class KolRunRecord {
  search_name string
  disease_resolved_as string @description("How the disease term resolved (MONDO/MeSH), and which spelling was queried. Never inferred from a filename — [[never-infer-authority-from-a-name]]")
  videos_considered int @description("The denominator. An absence is unreadable without it — [[record-what-was-in-scope]]")
  videos_with_transcript int
  videos_yielding_records int
  tools_required string[]
  tools_found string[]
  tools_missing string[] @description("[[verify-tools-before-running]]. A miss changes the plan; it never silently degrades the run")
  scope string @description("Search terms, caps and filters actually in force")
  assessments KolVideoAssessment[]
  assumptions Assumption[]
  conflicts Conflict[]
  guideline_set_version string @description("The guideline-set hash this run honoured, so a later reader can diff against it")
}

class KolVideoExtraction {
  records KolVideoRecord[] @description("The endpoint payload. Serialised as a bare JSON list under the '/market-intelligence/kol-videos/' key — no disease wrapper, matching api.py's read path.")
  run KolRunRecord
}
